+struct XUserGetTokenAndSignatureContext
+{
+    XUserHandle user;
+    XUserGetTokenAndSignatureOptions options;
+    char *url;
+    char *method;
+    SIZE_T headersSize;
+    char *headers;
+    SIZE_T bodySize;
+    void *bodyBuffer;
+    BOOLEAN isUtf16;
+    SIZE_T dataSize;
+    union
+    {
+        XUserGetTokenAndSignatureData *data;
+        XUserGetTokenAndSignatureUtf16Data *dataUtf16;
+    };
+};
