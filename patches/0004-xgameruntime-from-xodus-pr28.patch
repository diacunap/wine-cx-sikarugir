+    if (IsEqualGUID( iid, &IID_IUnknown             ) ||
+        IsEqualGUID( iid, &IID_IXAccessibilityImpl  ) ||
+        IsEqualGUID( iid, &IID_IXAccessibilityImpl2 ))
+    {
