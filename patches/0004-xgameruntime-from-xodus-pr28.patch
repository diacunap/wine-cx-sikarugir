+                WindowsDeleteString(impl->endpoints[i].host);
+                WindowsDeleteString(impl->endpoints[i].path);
+                WindowsDeleteString(impl->endpoints[i].relyingParty);
+                WindowsDeleteString(impl->endpoints[i].tokenType);
+            }
+            free( impl->endpoints );
+        }
+    }
+    return ref;
