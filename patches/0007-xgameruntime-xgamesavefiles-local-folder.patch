+/* XGameSaveFiles: a plain per-user, per-config folder the title writes files into.
+ * Local only for now (no titlestorage sync), next to the XGameSave container root. */
+static HRESULT files_folder( XUserHandle user, const char *configurationId, char **out )
+{
+    char localAppData[MAX_PATH], scid[128], *folder;
+
+    if (!(folder = malloc( MAX_PATH ))) return E_OUTOFMEMORY;
+    lstrcpynA( scid, configurationId, sizeof(scid) );
+    for (char *p = scid; *p; p++) if (!isalnum( (BYTE)*p ) && *p != '-') *p = '_';
+    if (!GetEnvironmentVariableA( "LOCALAPPDATA", localAppData, sizeof(localAppData) )) strcpy( localAppData, "C:\\users\\Public\\AppData\\Local" );
+    snprintf( folder, MAX_PATH, "%s\\XodusGameSave\\%I64u\\%s\\files", localAppData, xuser_get_xuid( user ), scid );
+    create_directories( folder );
+    TRACE( "user %p, configurationId %s -> %s.\n", user, debugstr_a( configurationId ), debugstr_a( folder ) );
+    *out = folder;
+    return S_OK;
+}
