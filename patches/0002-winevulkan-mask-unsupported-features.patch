+
+/* Sikarugir: some games (e.g. No Man's Sky) request core features MoltenVK can't
+ * provide (wideLines) and never check vkCreateDevice's result. With
+ * WINE_VK_MASK_UNSUPPORTED_FEATURES=1, drop unsupported VkPhysicalDeviceFeatures
+ * bits instead of failing with VK_ERROR_FEATURE_NOT_PRESENT. Opt-in on purpose. */
+static BOOL mask_unsupported_features_enabled(void)
+{
+    const char *env = getenv("WINE_VK_MASK_UNSUPPORTED_FEATURES");
+    return env && *env && *env != '0';
+}
+
+static void mask_unsupported_features(VkPhysicalDevice physical_device, VkPhysicalDeviceFeatures *features)
+{
+    VkPhysicalDeviceFeatures supported;
+    VkBool32 *want = (VkBool32 *)features, *have = (VkBool32 *)&supported;
+    uint32_t i;
+
+    vkGetPhysicalDeviceFeatures(physical_device, &supported);
+    for (i = 0; i < sizeof(*features) / sizeof(VkBool32); i++)
+    {
+        if (!want[i] || have[i]) continue;
+        WARN("masking unsupported VkPhysicalDeviceFeatures field %u\n", i);
+        want[i] = VK_FALSE;
+    }
 }
 
